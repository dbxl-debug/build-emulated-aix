#!/usr/bin/env python3
"""Minimal rcp client, for copying files to and from the AIX guest.

usage: rcp [-r] [-p] source... target

One side must be local and the other remote, written as [user@]host:path.
Runs "rcp -t" (receive) or "rcp -f" (send) on the remote host over rshd and
speaks the rcp protocol to it.
"""

import argparse
import os
import stat
import sys

from rcmd import die, local_user, rcmd

PROG = "rcp"
errors = 0


def warn(msg):
    global errors
    errors += 1
    sys.stderr.write(f"{PROG}: {msg}\n")


def parse_remote(arg):
    """Split [user@]host:path, or return None for a local path."""
    colon = arg.find(":")
    if colon <= 0 or "/" in arg[:colon]:
        return None
    host, path = arg[:colon], arg[colon + 1:] or "."
    user = None
    if "@" in host:
        user, host = host.rsplit("@", 1)
    return user or local_user(), host, path


class Conn:
    def __init__(self, sock):
        self.sock = sock
        self.rfile = sock.makefile("rb")

    def send(self, data):
        self.sock.sendall(data)

    def read_line(self):
        line = self.rfile.readline()
        if not line.endswith(b"\n"):
            die(PROG, "lost connection")
        return line[:-1].decode(errors="replace")

    def read_exact(self, n):
        data = self.rfile.read(n)
        if len(data) != n:
            die(PROG, "lost connection")
        return data

    def response(self):
        """Read the other side's acknowledgement; False on a warning."""
        code = self.rfile.read(1)
        if code == b"\0":
            return True
        if code in (b"\1", b"\2"):
            msg = self.read_line()
            sys.stderr.write(msg + "\n")
            if code == b"\2":
                sys.exit(1)
            global errors
            errors += 1
            return False
        die(PROG, "lost connection")


# local -> remote

def send_times(conn, st):
    conn.send(f"T{int(st.st_mtime)} 0 {int(st.st_atime)} 0\n".encode())
    return conn.response()


def send_file(conn, path, st, preserve):
    if preserve and not send_times(conn, st):
        return
    name = os.path.basename(path)
    conn.send(f"C{stat.S_IMODE(st.st_mode):04o} {st.st_size} {name}\n".encode())
    if not conn.response():
        return
    try:
        with open(path, "rb") as f:
            remaining = st.st_size
            while remaining > 0:
                chunk = f.read(min(remaining, 65536))
                if not chunk:
                    break
                conn.send(chunk)
                remaining -= len(chunk)
            # pad if the file shrank while we were sending it
            if remaining > 0:
                conn.send(b"\0" * remaining)
                raise OSError(f"{path}: file changed size")
    except OSError as e:
        conn.send(f"\1{PROG}: {e}\n".encode())
        warn(str(e))
    else:
        conn.send(b"\0")
    conn.response()


def send_path(conn, path, recursive, preserve):
    try:
        st = os.stat(path)
    except OSError as e:
        warn(f"{path}: {e.strerror}")
        return
    if stat.S_ISDIR(st.st_mode):
        if not recursive:
            warn(f"{path}: not a plain file")
            return
        if preserve and not send_times(conn, st):
            return
        name = os.path.basename(os.path.normpath(path))
        conn.send(f"D{stat.S_IMODE(st.st_mode):04o} 0 {name}\n".encode())
        if not conn.response():
            return
        for entry in sorted(os.listdir(path)):
            send_path(conn, os.path.join(path, entry), recursive, preserve)
        conn.send(b"E\n")
        conn.response()
    elif stat.S_ISREG(st.st_mode):
        send_file(conn, path, st, preserve)
    else:
        warn(f"{path}: not a plain file")


def upload(sources, user, host, path, recursive, preserve):
    flags = ("-r " if recursive else "") + ("-p " if preserve else "")
    sock, _ = rcmd(PROG, host, user, f"rcp {flags}-t {path}", want_stderr=False)
    conn = Conn(sock)
    conn.response()
    for src in sources:
        send_path(conn, src, recursive, preserve)


# remote -> local

def sink(conn, target, target_is_dir, recursive, preserve):
    times = None
    while True:
        code = conn.rfile.read(1)
        if not code:
            return
        if code in (b"\1", b"\2"):
            sys.stderr.write(conn.read_line() + "\n")
            if code == b"\2":
                sys.exit(1)
            global errors
            errors += 1
            continue
        line = conn.read_line()
        if code == b"E":
            conn.send(b"\0")
            return
        if code == b"T":
            mtime, _, atime, _ = (int(x) for x in line.split())
            times = (atime, mtime)
            conn.send(b"\0")
            continue
        if code not in (b"C", b"D"):
            die(PROG, f"protocol error: {code.decode(errors='replace')}{line}")

        mode, size, name = line.split(" ", 2)
        mode, size = int(mode, 8), int(size)
        if "/" in name or name in (".", ".."):
            die(PROG, f"protocol error: unexpected filename {name!r}")
        path = os.path.join(target, name) if target_is_dir else target

        if code == b"D":
            if not recursive:
                die(PROG, "received a directory without -r")
            try:
                if os.path.exists(path):
                    if not os.path.isdir(path):
                        raise OSError(f"{path}: not a directory")
                else:
                    os.mkdir(path, mode)
            except OSError as e:
                conn.send(f"\2{PROG}: {e}\n".encode())
                die(PROG, str(e))
            conn.send(b"\0")
            sink(conn, path, True, recursive, preserve)
            if preserve:
                os.chmod(path, mode)
            if times:
                os.utime(path, times)
            times = None
            continue

        conn.send(b"\0")
        error = None
        try:
            f = open(path, "wb")
            os.chmod(path, mode if preserve else mode & ~current_umask())
        except OSError as e:
            error, f = e, None
        remaining = size
        while remaining > 0:
            chunk = conn.rfile.read(min(remaining, 65536))
            if not chunk:
                die(PROG, "lost connection")
            if f and not error:
                try:
                    f.write(chunk)
                except OSError as e:
                    error = e
            remaining -= len(chunk)
        if f:
            f.close()
        conn.response()
        if not error and times:
            try:
                os.utime(path, times)
            except OSError as e:
                error = e
        times = None
        if error:
            conn.send(f"\1{PROG}: {path}: {error.strerror or error}\n".encode())
            warn(f"{path}: {error.strerror or error}")
        else:
            conn.send(b"\0")


def current_umask():
    mask = os.umask(0)
    os.umask(mask)
    return mask


def download(user, host, path, target, recursive, preserve):
    flags = ("-r " if recursive else "") + ("-p " if preserve else "")
    sock, _ = rcmd(PROG, host, user, f"rcp {flags}-f {path}", want_stderr=False)
    conn = Conn(sock)
    conn.send(b"\0")
    sink(conn, target, os.path.isdir(target), recursive, preserve)


def main():
    parser = argparse.ArgumentParser(prog=PROG)
    parser.add_argument("-r", action="store_true", help="copy directories recursively")
    parser.add_argument("-p", action="store_true", help="preserve times and modes")
    parser.add_argument("paths", nargs="+", metavar="source... target")
    args = parser.parse_args()

    if len(args.paths) < 2:
        parser.error("need at least one source and a target")
    *sources, target = args.paths

    remote_target = parse_remote(target)
    remote_sources = [parse_remote(s) for s in sources]

    if remote_target:
        if any(remote_sources):
            die(PROG, "remote to remote copies are not supported")
        user, host, path = remote_target
        upload(sources, user, host, path, args.r, args.p)
    else:
        if not all(remote_sources):
            die(PROG, "one side must be remote ([user@]host:path)")
        if len(sources) > 1 and not os.path.isdir(target):
            die(PROG, f"{target}: not a directory")
        for user, host, path in remote_sources:
            download(user, host, path, target, args.r, args.p)

    sys.exit(1 if errors else 0)


if __name__ == "__main__":
    main()
