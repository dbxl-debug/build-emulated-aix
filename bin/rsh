#!/usr/bin/env python3
"""Minimal rsh client, for talking to the AIX guest's rshd.

usage: rsh [-l user] [-n] host command...

As with the original rsh, the remote command's exit status is not returned.
"""

import argparse
import os
import select
import socket
import sys

from rcmd import die, local_user, rcmd


def main():
    parser = argparse.ArgumentParser(prog="rsh")
    parser.add_argument("-l", dest="user", help="remote user name")
    parser.add_argument("-n", action="store_true", help="don't read stdin")
    parser.add_argument("host")
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()

    if not args.command:
        die("rsh", "no command given (interactive rlogin is not supported)")

    main_sock, err_sock = rcmd("rsh", args.host, args.user or local_user(),
                               " ".join(args.command))

    stdin = None if args.n else sys.stdin.buffer
    stdout = sys.stdout.buffer
    stderr = sys.stderr.buffer
    open_socks = [main_sock, err_sock]

    while open_socks:
        readers = open_socks + ([stdin] if stdin else [])
        readable, _, _ = select.select(readers, [], [])
        for r in readable:
            if r is stdin:
                data = os.read(stdin.fileno(), 4096)
                if data:
                    main_sock.sendall(data)
                else:
                    main_sock.shutdown(socket.SHUT_WR)
                    stdin = None
                continue
            data = r.recv(4096)
            if not data:
                open_socks.remove(r)
                if r is main_sock:
                    stdin = None
                continue
            out = stdout if r is main_sock else stderr
            out.write(data)
            out.flush()


if __name__ == "__main__":
    main()
